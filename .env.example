# sqlctl runtime settings
#
# Copy this file to .env in the repository root and fill in values for your machine.
# The global editable sqlctl install loads this repository .env automatically.

# Optional: point sqlctl at an explicit TOML config file.
# SQLCTL_CONFIG=C:\path\to\sqlctl.toml

# Optional: override local state locations. If omitted, sqlctl uses the OS user state directory.
# SQLCTL_STORAGE_PATH=C:\Users\your_user\AppData\Local\sqlctl\sqlctl.sqlite3
# SQLCTL_MANAGED_ROOT=C:\Users\your_user\AppData\Local\sqlctl\managed

# Optional: disable whitespace normalization for source hashing.
# SQLCTL_NORMALIZE_WHITESPACE=true

# Required for the active rpa_mssql connection template in pyproject.toml.
SQLCTL_QUERY_STORE_MSSQL_SERVER=
SQLCTL_QUERY_STORE_MSSQL_DATABASE=
SQLCTL_QUERY_STORE_MSSQL_USERNAME=
SQLCTL_QUERY_STORE_MSSQL_PASSWORD=
